@model List<Lab08.Models.InventoryItem>

@{
    ViewData["Title"] = "Inventory";
}

<h2>Inventory Management System</h2>

<p>
    <a asp-controller="Inventory" asp-action="Create">
        Add New Item
    </a>
</p>

<table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>ID</th>
            <th>Item Name</th>
            <th>Quantity</th>
            <th>Price Per Unit</th>
            <th>Total Price</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.ItemName</td>
                <td>@item.Quantity</td>
                <td>₹@item.PricePerUnit.ToString("N2")</td>
                <td>₹@item.TotalPrice.ToString("N2")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">Edit</a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
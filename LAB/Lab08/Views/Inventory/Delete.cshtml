@model Lab08.Models.InventoryItem

@{
    ViewData["Title"] = "Delete Inventory Item";
}

<h2>Delete Inventory Item</h2>

<p>Are you sure you want to delete this item?</p>

<p><strong>ID:</strong> @Model.Id</p>
<p><strong>Item Name:</strong> @Model.ItemName</p>
<p><strong>Quantity:</strong> @Model.Quantity</p>
<p><strong>Price Per Unit:</strong> ₹@Model.PricePerUnit.ToString("N2")</p>
<p><strong>Total Price:</strong> ₹@Model.TotalPrice.ToString("N2")</p>

<form asp-controller="Inventory"
      asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit">Confirm Delete</button>
</form>

<p>
    <a asp-action="Index">Cancel</a>
</p>
@model LAB06.Models.Product

<h1>Product Details</h1>

<table border="1" cellpadding="10">
    <tr>
        <th>Product ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Product Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Category</th>
        <td>@Model.Category</td>
    </tr>

    <tr>
        <th>Brand</th>
        <td>@Model.Brand</td>
    </tr>

    <tr>
        <th>Price</th>
        <td>₹@Model.Price</td>
    </tr>

    <tr>
        <th>Color</th>
        <td>@Model.Color</td>
    </tr>

    <tr>
        <th>Available Stock</th>
        <td>@Model.Stock</td>
    </tr>

    <tr>
        <th>Description</th>
        <td>@Model.Description</td>
    </tr>
</table>

<br />

<a href="@Url.Action("Index", "Product")">
    Back to Product Catalog
</a>